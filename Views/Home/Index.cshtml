@model DashboardViewModel
@{
    ViewData["Title"] = "Сводка";
}
<div class="page-kicker">Личный бюджет</div>
<h1>Финансовая сводка за @DateTime.Today.ToString("MMMM yyyy")</h1>
<div class="cards">
    <div class="card income"><span>Доходы</span><strong>@Model.Income.ToString("N2") ₽</strong></div>
    <div class="card expense"><span>Расходы</span><strong>@Model.Expenses.ToString("N2") ₽</strong></div>
    <div class="card balance"><span>Баланс</span><strong>@Model.Balance.ToString("N2") ₽</strong></div>
</div>

<div class="actions"><a class="button" asp-controller="Transactions" asp-action="Create">＋ Добавить операцию</a><a class="button secondary" asp-controller="Budgets" asp-action="Create">Задать лимит</a></div>

<h2>Контроль бюджета</h2>
@if (Model.Budgets.Count == 0)
{
    <p class="empty-state">Лимиты на текущий месяц еще не заданы.</p>
}
else
{
    <div class="table-shell">
    <table><thead><tr><th>Категория</th><th>Потрачено</th><th>Лимит</th><th>Статус</th></tr></thead><tbody>
    @foreach (var b in Model.Budgets)
    {
        <tr class="@(b.IsExceeded ? "warning" : "")"><td>@b.Category</td><td>@b.Spent.ToString("N2") ₽</td><td>@b.Limit.ToString("N2") ₽</td><td><span class="badge @(b.IsExceeded ? "warn" : "ok")">@(b.IsExceeded ? "Превышен" : "В норме")</span></td></tr>
    }
    </tbody></table>
    </div>
}

<h2>Последние операции</h2>
@if (Model.RecentTransactions.Count == 0)
{
    <p class="empty-state">Добавьте первую финансовую операцию.</p>
}
else
{
    <div class="table-shell">
    <table><thead><tr><th>Дата</th><th>Тип</th><th>Категория</th><th>Описание</th><th>Сумма</th></tr></thead><tbody>
    @foreach (var x in Model.RecentTransactions)
    {
        <tr><td>@x.Date.ToString("dd.MM.yyyy")</td><td><span class="badge @(x.Type == TransactionType.Income ? "income" : "expense")">@(x.Type == TransactionType.Income ? "Доход" : "Расход")</span></td><td>@x.Category</td><td>@x.Description</td><td>@x.Amount.ToString("N2") ₽</td></tr>
    }
    </tbody></table>
    </div>
}
